# Copy to .env and fill in
# golden_key cookie from funpay.com (F12 -> Application -> Cookies)
FUNPAY_GOLDEN_KEY=
# Bot token from @BotFather (the whole token, including the part before ":")
TELEGRAM_BOT_TOKEN=
# Chat ids, comma-separated (get yours from @userinfobot; every recipient must press Start in the bot)
TELEGRAM_CHAT_ID=
# FunPay polling interval, seconds
POLL_DELAY=6
