# Скопируй в .env и заполни
# Cookie golden_key с funpay.com (F12 -> Application -> Cookies)
FUNPAY_GOLDEN_KEY=
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Chat id через запятую (узнать у @userinfobot; каждый должен нажать Start у бота)
TELEGRAM_CHAT_ID=
# Интервал опроса FunPay, секунд
POLL_DELAY=6
